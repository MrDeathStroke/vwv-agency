# Server-side env vars. Copy to .env.local for local dev. Never commit real values.

# Required — Resend API key for /api/inquiry
RESEND_API_KEY=

# From address. Must be on a verified Resend domain.
RESEND_FROM=VWV.agency <hello@vwv.agency>

# Where sprint inquiries get delivered (your inbox).
RESEND_INBOX=hello@vwv.agency
